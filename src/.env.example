# ===========================================
# DATABASE
# ===========================================

# Connection Pooling (para a app — usa pgBouncer)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?pgbouncer=true"

# Direct Connection (para migrações Prisma)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# ===========================================
# SUPABASE
# ===========================================

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ===========================================
# IA
# ===========================================
# As API keys dos provedores de IA (Anthropic, OpenAI, OpenCode Zen, etc.)
# são geridas dentro da app (Definições de IA), guardadas CIFRADAS na base de
# dados (ai_providers) com uma chave derivada da password da conta.
# Não são necessárias variáveis de ambiente aqui.