{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "functions": {
        "api/ai/*.ts": {
            "maxDuration": 300
        },
        "api/inngest.ts": {
            "maxDuration": 300
        }
    },
    "rewrites": [
        { "source": "/((?!api/).*)", "destination": "/index.html" }
    ]
}