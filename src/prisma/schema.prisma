// =============================================================================
// ContentOS — Prisma Schema
// Stack: Supabase (PostgreSQL) + Prisma ORM
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  OWNER
  EDITOR
  VIEWER
}

enum ContentPillar {
  P1_EDUCATION // Topo — Atrair
  P2_USE_CASES // Meio — Mostrar valor
  P3_CONVERSION // Fundo — Vender
  P4_AUTHORITY // Bastidores — Confiança
}

enum SocialChannel {
  LINKEDIN
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TWITTER
  FACEBOOK
  THREADS
  PINTEREST
  TELEGRAM
  WHATSAPP
}

// Tipos de peça GENÉRICOS: nenhum nome de plataforma. O canal é uma dimensão
// separada (`ContentPiece.channelId`) e decide como o conteúdo é escrito.
//   POST        — texto corrido (legenda, post, artigo). Thread é um POST
//                 sequencial nos canais que suportam `supportsThread`.
//   CAROUSEL    — sequência de slides. Vira texto numerado nos canais sem
//                 carrossel nativo (ver `platform-rules/platform-block`).
//   IMAGE       — imagem + legenda que a acompanha.
//   SHORT_VIDEO — vídeo curto (roteiro + artefacto de vídeo).
//   VIDEO       — vídeo longo (roteiro + artefacto de vídeo).
enum ContentFormat {
  POST
  CAROUSEL
  IMAGE
  SHORT_VIDEO
  VIDEO
}

enum ArticleStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
}

enum ContentPieceStatus {
  PROMPT_READY // Peça criada só com o prompt gravado (ainda sem conteúdo)
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHED
}

enum PlanItemStatus {
  PLANNED
  PUBLISHED
  SKIPPED
}

enum FunnelStage {
  TOP // Atração
  MIDDLE // Consideração
  BOTTOM // Conversão
}

enum PromptTargetType {
  PIECE
}

enum PublicationTargetType {
  ARTICLE
  PIECE
}

// Tipo de entidade a que um artefacto está ligado. Enum próprio (e não
// PublicationTargetType) para os dois catálogos poderem divergir sem couplings.
enum AssetTargetType {
  ARTICLE
  PIECE
}

// Como nasceu um artefacto. UPLOAD = ficheiro carregado pelo utilizador;
// GENERATED = produzido por um modelo de media (ver server/media/).
enum AssetSource {
  UPLOAD
  GENERATED
}

// Estado do artefacto. Só os gerados usam PENDING/GENERATING/FAILED — um
// upload entra sempre como READY.
enum AssetStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

// Modalidades de saída de um modelo. Ver `lib/platform-rules` para os canais e
// `server/media/dispatcher` para a resolução de modelo por modalidade.
enum GenerationJobType {
  NEW_ARTICLE
  CONTENT_PIECES
  CONTENT_PROMPT // Escreve o prompt da peça (sem gerar o conteúdo)
  CONTENT_ITEM // Regenera um item (slide-N / scene-N) a partir do seu prompt
  ARTICLE_METADATA // Gera os metadados (summary/keywords/SEO) de um artigo existente
  MEDIA_PROMPT // Gera o prompt de media (imagem/áudio/vídeo) de uma peça ou artigo
  MEDIA_ARTIFACT // Gera o ficheiro de media a partir do prompt guardado
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  EXPIRED // Job deixado de fora por uma migração que invalidou os seus params
}

// =============================================================================
// WORKSPACE (Multi-tenant root)
// =============================================================================

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique // URL-friendly identifier
  description String?
  logoUrl     String?
  sector      String? // Ex: "SaaS", "Consultoria", "E-commerce"
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Configurações de voz e tom
  voiceTone        String? // Ex: "directo e técnico", "casual mas profissional"
  targetAudience   String? // Ex: "PMEs angolanas", "Startups B2B"
  contentLanguage  String  @default("pt") // Idioma principal do conteúdo
  valueProposition String? // Proposta de valor da empresa (alimenta IA)

  // Regras operacionais (baseadas no documento)
  valueRatio      Int @default(70) // % de conteúdo de valor (padrão 70/30)
  productRatio    Int @default(30) // % de conteúdo de produto
  postsPerWeek    Int @default(3)
  articlesPerWeek Int @default(1)

  // Configurações de IA
  defaultAIProviderId String? // Row id (UUID) do AIProvider padrão
  defaultAIModel      String? // Código do modelo padrão (ex: "claude-sonnet-4-20250514")

  // Modelo por modalidade de media: { image?, audio?, video? } com modelCode.
  // Ausente/null = "Automático" (1º modelo activo da modalidade por priority).
  artifactModels Json?

  // Relações
  members       WorkspaceMember[]
  products      Product[]
  pillars       PillarConfig[]
  channelConfig ChannelConfig[]
  articles      Article[]
  weeklyPlans   WeeklyPlan[]
  planningConfigs PlanningConfig[]
  tags          Tag[]
  aiSystemPrompts AISystemPrompt[]

  @@map("workspaces")
}

// =============================================================================
// WORKSPACE MEMBERS (Auth)
// =============================================================================

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String // Supabase auth.users UUID
  role        UserRole @default(EDITOR)
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// =============================================================================
// PRODUCTS (Produtos da empresa)
// =============================================================================

model Product {
  id             String   @id @default(uuid())
  workspaceId    String
  name           String
  slug           String
  description    String?
  tagline        String? // Frase curta para usar em CTAs
  landingUrl     String? // URL da landing page
  demoUrl        String?
  targetAudience String? // Público específico do produto
  problemSolved  String? // Problema que resolve (para prompts IA)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles      Article[]
  contentPieces ContentPiece[]
  planItems     PlanItem[]

  @@unique([workspaceId, slug])
  @@map("products")
}

// =============================================================================
// PILLAR CONFIG (Pilares de conteúdo configuráveis)
// =============================================================================

model PillarConfig {
  id          String        @id @default(uuid())
  workspaceId String
  pillar      ContentPillar
  name        String // Nome customizável (ex: "Educação & Problemas")
  objective   String? // Objetivo do pilar
  funnelStage FunnelStage
  description String? // Descrição interna
  examples    String[] // Exemplos de temas (array de strings)
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles  Article[]
  planItems PlanItem[]
  suggestedForDays PlanningConfig[]

  @@unique([workspaceId, pillar])
  @@map("pillar_configs")
}

// =============================================================================
// CHANNEL CONFIG (Configuração por canal)
// =============================================================================

model ChannelConfig {
  id          String        @id @default(uuid())
  workspaceId String
  channel     SocialChannel
  isActive    Boolean       @default(true)
  handle      String? // @username ou URL do perfil
  isPrimary   Boolean       @default(false) // Canal principal (ex: LinkedIn B2B)
  defaultTone String? // Tom específico deste canal. Sobrepõe o voiceTone do workspace.
  notes       String? // Instruções internas que a IA recebe para este canal
  // Overrides das regras de plataforma, por campo (ver ChannelRules).
  // null / campo ausente = herdar o default de `lib/platform-rules`.
  rules       Json?
  createdAt   DateTime      @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentPieces ContentPiece[]
  planItems     PlanItem[]

  @@unique([workspaceId, channel])
  @@map("channel_configs")
}

// =============================================================================
// TAGS (Etiquetas transversais)
// =============================================================================

model Tag {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String? // Hex color para UI
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles  ArticleTag[]

  @@unique([workspaceId, name])
  @@map("tags")
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

// =============================================================================
// ARTICLES (Artigos do blog — fonte de conteúdo)
// =============================================================================

model Article {
  id          String  @id @default(uuid())
  workspaceId String
  productId   String? // Produto relacionado (opcional)
  pillarId    String? // Pilar de conteúdo

  // Conteúdo
  title   String
  slug    String // Gerado automaticamente pela IA
  summary String? // Resumo/meta description
  body    String // Corpo completo do artigo (Markdown)

  // SEO
  seoTitle       String?
  seoDescription String?
  keywords       String[] // Keywords para SEO

  // Estado
  status       ArticleStatus @default(DRAFT)
  publishedAt  DateTime?
  publishedUrl String? // URL final no site

  // Artefactos: ver tabela content_assets (N artefactos por artigo)

  // IA
  aiGenerated  Boolean @default(false)
  aiPromptUsed String? // Prompt usado para gerar (auditoria)

  // Metadados
  readingTimeMin Int? // Tempo estimado de leitura
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String? // Supabase auth.users UUID

  // Relações
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id])
  pillar        PillarConfig?  @relation(fields: [pillarId], references: [id])
  tags          ArticleTag[]
  contentPieces ContentPiece[]
  planItems     PlanItem[]

  @@unique([workspaceId, slug])
  @@map("articles")
}

// =============================================================================
// CONTENT PIECES (Derivados do artigo para cada rede social)
// Cada artigo gera 3-5 peças de conteúdo
// =============================================================================

model ContentPiece {
  id          String  @id @default(uuid())
  articleId   String
  workspaceId String
  productId   String? // Produto mencionado nesta peça
  channelId   String? // Canal alvo

  // Classificação
  format ContentFormat
  pillar ContentPillar?

  // Conteúdo
  title    String? // Título interno/referência
  body     String // Texto principal da peça
  hookText String? // Frase de abertura (gancho)
  ctaText  String? // Call to action
  hashtags String[] // Hashtags (para Instagram/TikTok)

  // Carrossel específico
  slides     Json? // Array de slides: [{order, title, body}]
  slideCount Int?

  // Vídeo (SHORT_VIDEO / VIDEO). `scenes` é a decomposição em cenas que o
  // prompt-writer e a geração de media usam: [{order, kind, narration, visual, onScreenText}]
  scenes      Json?
  durationSec Int?

  // Estado
  status      ContentPieceStatus @default(DRAFT)
  publishedAt DateTime?

  // Artefactos: ver tabela content_assets (N artefactos por peça)

  // IA
  aiGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product   Product?       @relation(fields: [productId], references: [id])
  channel   ChannelConfig? @relation(fields: [channelId], references: [id])
  planItems PlanItem[]

  @@map("content_pieces")
}

// =============================================================================
// WEEKLY PLANS (Planeamento semanal)
// =============================================================================

model WeeklyPlan {
  id          String   @id @default(uuid())
  workspaceId String
  weekStart   DateTime // Segunda-feira da semana (normalizado)
  weekEnd     DateTime // Domingo da semana
  notes       String? // Notas gerais da semana
  theme       String? // Tema/foco semanal opcional
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     PlanItem[]

  @@unique([workspaceId, weekStart])
  @@map("weekly_plans")
}

// =============================================================================
// PLAN ITEMS (Items agendados dentro de um plano semanal)
// Cada item liga um conteúdo a um dia e canal específico
// =============================================================================

model PlanItem {
  id           String @id @default(uuid())
  weeklyPlanId String
  workspaceId  String

  // O que vai ser publicado (um dos três é obrigatório)
  articleId      String? // Se for partilha de artigo
  contentPieceId String? // Se for peça derivada (carrossel, post, etc.)
  productId      String? // Produto em destaque

  // Quando e onde
  pillarId     String? // Pilar associado
  channelId    String? // Canal alvo
  scheduledFor DateTime // Data e hora planeada
  dayOfWeek    Int // 1=Segunda ... 7=Domingo

  // Estado
  status       PlanItemStatus @default(PLANNED)
  publishedAt  DateTime? // Data real de publicação
  publishedUrl String? // URL do post publicado (para tracking)
  notes        String? // Notas internas do item

  // Metadados
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  weeklyPlan   WeeklyPlan     @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  article      Article?       @relation(fields: [articleId], references: [id])
  contentPiece ContentPiece?  @relation(fields: [contentPieceId], references: [id])
  product      Product?       @relation(fields: [productId], references: [id])
  pillar       PillarConfig?  @relation(fields: [pillarId], references: [id])
  channel      ChannelConfig? @relation(fields: [channelId], references: [id])

  @@map("plan_items")
}

// =============================================================================
// PLANNING CONFIG (Configuração dos dias de planeamento)
// Uma linha por dia da semana (1=Segunda ... 7=Domingo).
//
// `isActive` NÃO é um bloqueio: a grelha mostra sempre os 7 dias e todos
// aceitam items. Activar um dia é destacá-lo e atribuir-lhe um pilar
// sugerido. Desactivar um dia não apaga nem esconde items já agendados.
//
// `suggestedPillarId` aponta para pillar_configs.id (UUID) e NÃO para o enum
// ContentPillar — o enum vive na linha do pilar. Ver planning-config.service,
// que faz o join e devolve os dois.
// =============================================================================

model PlanningConfig {
  id          String @id @default(uuid())
  workspaceId String
  dayOfWeek   Int // 1=Segunda ... 7=Domingo
  isActive    Boolean @default(true)
  suggestedPillarId String? // Pilar sugerido para este dia (opcional)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  suggestedPillar PillarConfig?  @relation(fields: [suggestedPillarId], references: [id])

  @@unique([workspaceId, dayOfWeek])
  @@map("planning_configs")
}

// =============================================================================
// AI PROVIDERS (Provedores de IA globais da conta)
// =============================================================================

model AIProvider {
  id          String   @id @default(uuid())
  providerId  String   // ID técnico: "anthropic", "openai", "custom_abc123"
  name        String   // Nome de exibição
  description String?
  baseUrl     String?  // URL base da API (obrigatório para custom)

  // Scoping: exatamente um de userId/workspaceId (CHECK no migration SQL)
  userId      String? // Dono a nível de utilizador (acessível em todos os workspaces dele)
  workspaceId String? // Workspace específico (só membros desse workspace)

  apiKeyEncrypted String? // API key cifrada (AES-GCM, chave derivada da password)
  apiKeyIv        String? // IV (base64) usado na cifra da API key
  config          Json?   // Configuração padrão do provider (temperature, max_tokens, ...)
  isDefault       Boolean @default(false) // true para os pré-cadastrados
  isCustom        Boolean @default(false) // true para provedores do utilizador
  isActive        Boolean @default(true)
  priority        Int     @default(0) // Ordem no fallback (dentro do scope do dono)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  models  AIProviderModel[]
  headers AIProviderHeader[]

  @@index([userId])
  @@index([workspaceId])
  @@map("ai_providers")
}

// =============================================================================
// AI PROVIDER MODELS (Modelos de cada provedor)
// =============================================================================

model AIProviderModel {
  id          String   @id @default(uuid())
  providerId  String
  displayName String   // "Claude Sonnet 4"
  modelCode   String   // "claude-sonnet-4-20250514"
  config      Json?    // Configuração padrão do modelo (temperature, max_tokens, ...)
  // Que tipos de dados este modelo produz: ["text"] | ["image"] | ["audio"] |
  // ["video"] | combinações (ex.: ["text","image"]) | ["embedding"] | ["other"].
  // Vazio = desconhecido (a UI de artefactos mostra "sem modelo definido").
  modalities  String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("ai_provider_models")
}

// =============================================================================
// AI PROVIDER HEADERS (Headers HTTP customizados)
// =============================================================================

model AIProviderHeader {
  id         String   @id @default(uuid())
  providerId String
  key        String   // "X-Custom-Auth"
  value      String   // "xyz"
  createdAt  DateTime @default(now())

  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("ai_provider_headers")
}

// =============================================================================
// AI SYSTEM PROMPTS (Prompts globais por tipo de conteúdo — nunca por provider)
// Resolução: workspace → user → default no código. CHECK exatamente um de
// userId/workspaceId (migration SQL).
// =============================================================================

model AISystemPrompt {
  id           String   @id @default(uuid())
  userId       String? // Override a nível de utilizador
  workspaceId  String? // Override a nível de workspace (ganha sobre o do utilizador)
  // Tipo de conteúdo: "article" | os 5 tipos genéricos (POST, CAROUSEL, IMAGE,
  // SHORT_VIDEO, VIDEO) | os `media_*` | os escritores `prompt_<TIPO>`. Texto
  // livre de propósito — a taxonomia vive em código (`helpers/content-format.ts`,
  // `lib/ai/content-prompts.ts`), não num enum que fossilizaria as chaves.
  contentType  String
  systemPrompt String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType])
  @@unique([workspaceId, contentType])
  @@index([workspaceId])
  @@map("ai_system_prompts")
}

// =============================================================================
// CONTENT GENERATION PROMPTS (Prompt final portátil de cada item gerado)
// Uma linha por item (carrossel → por slide; vídeo → por cena; simples → "main").
// =============================================================================

model ContentGenerationPrompt {
  id         String           @id @default(uuid())
  targetType PromptTargetType // PIECE
  targetId   String           // content_pieces.id (polimórfico)
  itemKey    String?          // "main" | "slide-1" | "scene-3" | ...
  prompt     String           // Prompt final self-contained (portátil)
  providerId String?          // Row id do ai_providers usado na geração
  modelCode  String?          // Código do modelo usado na geração
  createdAt  DateTime         @default(now())
  editedAt   DateTime?        // Preenchido quando o utilizador edita o prompt à mão

  // Um prompt por item. O app escreve sempre `itemKey` ('main' quando não há
  // item explícito) — a migração normaliza os NULL herdados antes de criar isto.
  @@unique([targetType, targetId, itemKey])
  @@index([targetType, targetId])
  @@map("content_generation_prompts")
}

// =============================================================================
// CONTENT MEDIA PROMPTS (Prompt de media genérico e portátil)
// Uma linha por (alvo, modalidade, itemKey). O prompt é SEMPRE puro descritivo
// — nunca nome de plataforma, formato nem limites — para poder ser gerado noutro
// sítio. A descrição semântica vem do próprio conteúdo: `slides[n].text` num
// carrossel, `scenes[n]` num vídeo, `[IMAGEM SUGERIDA — ...]` num artigo.
// =============================================================================

model ContentMediaPrompt {
  id          String          @id @default(uuid())
  workspaceId String
  targetType  AssetTargetType // ARTICLE | PIECE
  targetId    String          // articles.id | content_pieces.id
  modality    String          // "image" | "audio" | "video"
  itemKey     String          // "main" | "slide-1" | "scene-2" | "ilustracao-3"
  prompt      String          // Prompt portátil (sem plataforma/dimensões)
  negativePrompt String?      // Só para imagem/vídeo
  // Aspecto/dimensões vai FORA do prompt, como parâmetro da API (Decisão 29).
  aspectRatio String?
  providerId  String? // Row id do ai_providers que escreveu o prompt
  modelCode   String? // Código do modelo que escreveu o prompt
  createdAt   DateTime        @default(now())
  editedAt    DateTime?       // Preenchido quando o utilizador edita à mão

  @@unique([targetType, targetId, modality, itemKey])
  @@index([workspaceId])
  @@index([targetType, targetId])
  @@map("content_media_prompts")
}

// =============================================================================
// CONTENT PUBLICATIONS (Publicações multi-plataforma de conteúdo publicável)
// Polimórfico: ARTICLE | PIECE → targetId.
// =============================================================================

model ContentPublication {
  id         String                @id @default(uuid())
  targetType PublicationTargetType // ARTICLE | PIECE
  targetId   String                // articles.id | content_pieces.id
  platform   SocialChannel         // Plataforma onde foi publicado
  url        String                // Link da publicação
  publishedAt DateTime             @default(now())
  createdAt   DateTime             @default(now())

  @@index([targetType, targetId])
  @@map("content_publications")
}

// =============================================================================
// CONTENT ASSETS (Artefactos — vários por entidade, polimórfico)
// Substitui as antigas colunas assetUrl/assetName em articles/content_pieces,
// que só permitiam um artefacto por entidade.
// =============================================================================

model ContentAsset {
  id          String          @id @default(uuid())
  workspaceId String          // Âmbito do workspace (verificação de fetch)
  targetType  AssetTargetType // ARTICLE | PIECE
  targetId    String          // articles.id | content_pieces.id
  url         String          // URL do Storage ou link externo
  name        String? // Nome do ficheiro
  mimeType    String? // MIME do upload; para links externos, inferido da extensão
  // Proveniência. UPLOAD = carregado pelo utilizador (default);
  // GENERATED = produzido por server/media/.
  source      AssetSource     @default(UPLOAD)
  status      AssetStatus     @default(READY)
  error       String? // Motivo da falha (só GENERATED)
  itemKey     String? // "main" | "slide-2" | "scene-1" | "ilustracao-1"
  mediaPromptId String? // content_media_prompts.id que gerou este ficheiro
  providerId  String? // ai_providers.id que gerou
  modelCode   String? // modelo que gerou
  createdAt   DateTime        @default(now())

  @@index([workspaceId])
  @@index([targetType, targetId])
  @@index([status])
  // A grelha de artefactos ordena por createdAt DESC.
  @@index([createdAt])
  @@map("content_assets")
}

// =============================================================================
// GENERATION JOBS (Geração de IA assíncrona via Inngest)
// Polimórfico: um job por pedido de geração. `targetId` aponta ao objeto de
// destino (article placeholder, content piece no batch, script placeholder) e
// `items` guarda o estado por item nos batches de CONTENT_PIECES.
// =============================================================================

model GenerationJob {
  id          String              @id @default(uuid())
  jobType     GenerationJobType
  workspaceId String
  userId      String? // Criador (auth.users UUID)
  status      GenerationJobStatus @default(QUEUED)
  error       String? // Motivo de falha (visível na UI)
  items       Json? // [{ format, targetId, status, error }] por item (CONTENT_PIECES)
  params      Json? // Snapshot dos parâmetros da geração (para retry)
  runId       String? // Inngest run id (idempotência/pista)
  targetId    String? // NEW_ARTICLE → id do placeholder; CONTENT_PIECES → articleId
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([workspaceId, status])
  @@index([jobType, targetId, status])
  @@map("generation_jobs")
}
