// =============================================================================
// ContentOS — Prisma Schema
// Stack: Supabase (PostgreSQL) + Prisma ORM
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  OWNER
  EDITOR
  VIEWER
}

enum ContentPillar {
  P1_EDUCATION // Topo — Atrair
  P2_USE_CASES // Meio — Mostrar valor
  P3_CONVERSION // Fundo — Vender
  P4_AUTHORITY // Bastidores — Confiança
}

enum SocialChannel {
  LINKEDIN
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TWITTER
  FACEBOOK
  THREADS
  PINTEREST
  TELEGRAM
  WHATSAPP
}

enum ContentFormat {
  CAROUSEL // Carrossel (slides)
  SHORT_VIDEO // TikTok / Reels
  LINKEDIN_POST // Post opinativo LinkedIn
  IMAGE
  THREAD // Thread (X/Twitter)
  CTA_POST // Call to Action direto
  VIDEO_SCRIPT // Roteiro de vídeo
}

enum ArticleStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
}

enum ContentPieceStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHED
}

enum PlanItemStatus {
  PLANNED
  PUBLISHED
  SKIPPED
}

enum FunnelStage {
  TOP // Atração
  MIDDLE // Consideração
  BOTTOM // Conversão
}

enum PromptTargetType {
  PIECE
  VIDEO_SCRIPT
}

enum PublicationTargetType {
  ARTICLE
  PIECE
  VIDEO_SCRIPT
}

// =============================================================================
// WORKSPACE (Multi-tenant root)
// =============================================================================

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique // URL-friendly identifier
  description String?
  logoUrl     String?
  sector      String? // Ex: "SaaS", "Consultoria", "E-commerce"
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Configurações de voz e tom
  voiceTone        String? // Ex: "directo e técnico", "casual mas profissional"
  targetAudience   String? // Ex: "PMEs angolanas", "Startups B2B"
  contentLanguage  String  @default("pt") // Idioma principal do conteúdo
  valueProposition String? // Proposta de valor da empresa (alimenta IA)

  // Regras operacionais (baseadas no documento)
  valueRatio      Int @default(70) // % de conteúdo de valor (padrão 70/30)
  productRatio    Int @default(30) // % de conteúdo de produto
  postsPerWeek    Int @default(3)
  articlesPerWeek Int @default(1)

  // Configurações de IA
  defaultAIProviderId String? // Row id (UUID) do AIProvider padrão
  defaultAIModel      String? // Código do modelo padrão (ex: "claude-sonnet-4-20250514")

  // Relações
  members       WorkspaceMember[]
  products      Product[]
  pillars       PillarConfig[]
  channelConfig ChannelConfig[]
  articles      Article[]
  weeklyPlans   WeeklyPlan[]
  tags          Tag[]
  aiSystemPrompts AISystemPrompt[]

  @@map("workspaces")
}

// =============================================================================
// WORKSPACE MEMBERS (Auth)
// =============================================================================

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String // Supabase auth.users UUID
  role        UserRole @default(EDITOR)
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// =============================================================================
// PRODUCTS (Produtos da empresa)
// =============================================================================

model Product {
  id             String   @id @default(uuid())
  workspaceId    String
  name           String
  slug           String
  description    String?
  tagline        String? // Frase curta para usar em CTAs
  landingUrl     String? // URL da landing page
  demoUrl        String?
  targetAudience String? // Público específico do produto
  problemSolved  String? // Problema que resolve (para prompts IA)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles      Article[]
  contentPieces ContentPiece[]
  planItems     PlanItem[]

  @@unique([workspaceId, slug])
  @@map("products")
}

// =============================================================================
// PILLAR CONFIG (Pilares de conteúdo configuráveis)
// =============================================================================

model PillarConfig {
  id          String        @id @default(uuid())
  workspaceId String
  pillar      ContentPillar
  name        String // Nome customizável (ex: "Educação & Problemas")
  objective   String? // Objetivo do pilar
  funnelStage FunnelStage
  description String? // Descrição interna
  examples    String[] // Exemplos de temas (array de strings)
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles  Article[]
  planItems PlanItem[]

  @@unique([workspaceId, pillar])
  @@map("pillar_configs")
}

// =============================================================================
// CHANNEL CONFIG (Configuração por canal)
// =============================================================================

model ChannelConfig {
  id          String        @id @default(uuid())
  workspaceId String
  channel     SocialChannel
  isActive    Boolean       @default(true)
  handle      String? // @username ou URL do perfil
  isPrimary   Boolean       @default(false) // Canal principal (ex: LinkedIn B2B)
  defaultTone String? // Tom específico para este canal
  notes       String? // Notas internas
  createdAt   DateTime      @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentPieces ContentPiece[]
  planItems     PlanItem[]

  @@unique([workspaceId, channel])
  @@map("channel_configs")
}

// =============================================================================
// TAGS (Etiquetas transversais)
// =============================================================================

model Tag {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String? // Hex color para UI
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles  ArticleTag[]

  @@unique([workspaceId, name])
  @@map("tags")
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

// =============================================================================
// ARTICLES (Artigos do blog — fonte de conteúdo)
// =============================================================================

model Article {
  id          String  @id @default(uuid())
  workspaceId String
  productId   String? // Produto relacionado (opcional)
  pillarId    String? // Pilar de conteúdo

  // Conteúdo
  title   String
  slug    String // Gerado automaticamente pela IA
  summary String? // Resumo/meta description
  body    String // Corpo completo do artigo (Markdown)

  // SEO
  seoTitle       String?
  seoDescription String?
  keywords       String[] // Keywords para SEO

  // Estado
  status       ArticleStatus @default(DRAFT)
  publishedAt  DateTime?
  publishedUrl String? // URL final no site

  // Artefacto publicado
  assetUrl  String? // URL do artefacto (Storage assets ou link externo)
  assetName String? // Nome do ficheiro do artefacto

  // IA
  aiGenerated  Boolean @default(false)
  aiPromptUsed String? // Prompt usado para gerar (auditoria)

  // Metadados
  readingTimeMin Int? // Tempo estimado de leitura
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String? // Supabase auth.users UUID

  // Relações
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id])
  pillar        PillarConfig?  @relation(fields: [pillarId], references: [id])
  tags          ArticleTag[]
  contentPieces ContentPiece[]
  videoScripts  VideoScript[]
  planItems     PlanItem[]

  @@unique([workspaceId, slug])
  @@map("articles")
}

// =============================================================================
// CONTENT PIECES (Derivados do artigo para cada rede social)
// Cada artigo gera 3-5 peças de conteúdo
// =============================================================================

model ContentPiece {
  id          String  @id @default(uuid())
  articleId   String
  workspaceId String
  productId   String? // Produto mencionado nesta peça
  channelId   String? // Canal alvo

  // Classificação
  format ContentFormat
  pillar ContentPillar?

  // Conteúdo
  title    String? // Título interno/referência
  body     String // Texto principal da peça
  hookText String? // Frase de abertura (gancho)
  ctaText  String? // Call to action
  hashtags String[] // Hashtags (para Instagram/TikTok)

  // Carrossel específico
  slides     Json? // Array de slides: [{order, title, body}]
  slideCount Int?

  // Estado
  status      ContentPieceStatus @default(DRAFT)
  publishedAt DateTime?

  // Artefacto publicado
  assetUrl  String? // URL do artefacto (Storage assets ou link externo)
  assetName String? // Nome do ficheiro do artefacto

  // IA
  aiGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product   Product?       @relation(fields: [productId], references: [id])
  channel   ChannelConfig? @relation(fields: [channelId], references: [id])
  planItems PlanItem[]

  @@map("content_pieces")
}

// =============================================================================
// VIDEO SCRIPTS (Roteiros de vídeo curto — TikTok / Reels)
// =============================================================================

model VideoScript {
  id          String @id @default(uuid())
  articleId   String
  workspaceId String

  // Conteúdo do roteiro
  title      String
  hook       String // Primeiros 3 segundos (gancho visual/verbal)
  problem    String? // Apresentação do problema
  solution   String? // A solução / conteúdo central
  cta        String // Call to action final
  fullScript String // Roteiro completo formatado

  // Configuração de produção
  durationSec   Int?          @default(60) // Duração estimada em segundos
  targetChannel SocialChannel @default(INSTAGRAM) // INSTAGRAM ou TIKTOK
  onScreenText  String? // Textos para aparecer no vídeo
  bRoll         String? // Sugestões de b-roll / cenas de apoio

  // Estado
  status      ArticleStatus @default(DRAFT) // Reutiliza enum
  aiGenerated Boolean       @default(false)

  // Artefacto publicado
  assetUrl  String? // URL do artefacto (Storage assets ou link externo)
  assetName String? // Nome do ficheiro do artefacto

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("video_scripts")
}

// =============================================================================
// WEEKLY PLANS (Planeamento semanal)
// =============================================================================

model WeeklyPlan {
  id          String   @id @default(uuid())
  workspaceId String
  weekStart   DateTime // Segunda-feira da semana (normalizado)
  weekEnd     DateTime // Domingo da semana
  notes       String? // Notas gerais da semana
  theme       String? // Tema/foco semanal opcional
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     PlanItem[]

  @@unique([workspaceId, weekStart])
  @@map("weekly_plans")
}

// =============================================================================
// PLAN ITEMS (Items agendados dentro de um plano semanal)
// Cada item liga um conteúdo a um dia e canal específico
// =============================================================================

model PlanItem {
  id           String @id @default(uuid())
  weeklyPlanId String
  workspaceId  String

  // O que vai ser publicado (um dos três é obrigatório)
  articleId      String? // Se for partilha de artigo
  contentPieceId String? // Se for peça derivada (carrossel, post, etc.)
  productId      String? // Produto em destaque

  // Quando e onde
  pillarId     String? // Pilar associado
  channelId    String? // Canal alvo
  scheduledFor DateTime // Data e hora planeada
  dayOfWeek    Int // 1=Segunda ... 7=Domingo

  // Estado
  status       PlanItemStatus @default(PLANNED)
  publishedAt  DateTime? // Data real de publicação
  publishedUrl String? // URL do post publicado (para tracking)
  notes        String? // Notas internas do item

  // Metadados
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  weeklyPlan   WeeklyPlan     @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  article      Article?       @relation(fields: [articleId], references: [id])
  contentPiece ContentPiece?  @relation(fields: [contentPieceId], references: [id])
  product      Product?       @relation(fields: [productId], references: [id])
  pillar       PillarConfig?  @relation(fields: [pillarId], references: [id])
  channel      ChannelConfig? @relation(fields: [channelId], references: [id])

  @@map("plan_items")
}

// =============================================================================
// AI PROVIDERS (Provedores de IA globais da conta)
// =============================================================================

model AIProvider {
  id          String   @id @default(uuid())
  providerId  String   // ID técnico: "anthropic", "openai", "custom_abc123"
  name        String   // Nome de exibição
  description String?
  baseUrl     String?  // URL base da API (obrigatório para custom)

  // Scoping: exatamente um de userId/workspaceId (CHECK no migration SQL)
  userId      String? // Dono a nível de utilizador (acessível em todos os workspaces dele)
  workspaceId String? // Workspace específico (só membros desse workspace)

  apiKeyEncrypted String? // API key cifrada (AES-GCM, chave derivada da password)
  apiKeyIv        String? // IV (base64) usado na cifra da API key
  config          Json?   // Configuração padrão do provider (temperature, max_tokens, ...)
  isDefault       Boolean @default(false) // true para os pré-cadastrados
  isCustom        Boolean @default(false) // true para provedores do utilizador
  isActive        Boolean @default(true)
  priority        Int     @default(0) // Ordem no fallback (dentro do scope do dono)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  models  AIProviderModel[]
  headers AIProviderHeader[]

  @@index([userId])
  @@index([workspaceId])
  @@map("ai_providers")
}

// =============================================================================
// AI PROVIDER MODELS (Modelos de cada provedor)
// =============================================================================

model AIProviderModel {
  id          String   @id @default(uuid())
  providerId  String
  displayName String   // "Claude Sonnet 4"
  modelCode   String   // "claude-sonnet-4-20250514"
  config      Json?    // Configuração padrão do modelo (temperature, max_tokens, ...)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("ai_provider_models")
}

// =============================================================================
// AI PROVIDER HEADERS (Headers HTTP customizados)
// =============================================================================

model AIProviderHeader {
  id         String   @id @default(uuid())
  providerId String
  key        String   // "X-Custom-Auth"
  value      String   // "xyz"
  createdAt  DateTime @default(now())

  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("ai_provider_headers")
}

// =============================================================================
// AI SYSTEM PROMPTS (Prompts globais por tipo de conteúdo — nunca por provider)
// Resolução: workspace → user → default no código. CHECK exatamente um de
// userId/workspaceId (migration SQL).
// =============================================================================

model AISystemPrompt {
  id           String   @id @default(uuid())
  userId       String? // Override a nível de utilizador
  workspaceId  String? // Override a nível de workspace (ganha sobre o do utilizador)
  contentType  String // "article" | "image" | "carousel" | "linkedin_post" | ...
  systemPrompt String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType])
  @@unique([workspaceId, contentType])
  @@index([workspaceId])
  @@map("ai_system_prompts")
}

// =============================================================================
// CONTENT GENERATION PROMPTS (Prompt final portátil de cada peça/roteiro gerado)
// Uma linha por item (carrossel → por slide; thread → por tweet; simples → "main").
// =============================================================================

model ContentGenerationPrompt {
  id         String           @id @default(uuid())
  targetType PromptTargetType // PIECE | VIDEO_SCRIPT
  targetId   String           // content_pieces.id ou video_scripts.id (polimórfico)
  itemKey    String?          // "main" | "slide-1" | "tweet-3" | ...
  prompt     String           // Prompt final self-contained (portátil)
  providerId String?          // Row id do ai_providers usado na geração
  modelCode  String?          // Código do modelo usado na geração
  createdAt  DateTime         @default(now())

  @@index([targetType, targetId])
  @@map("content_generation_prompts")
}

// =============================================================================
// CONTENT PUBLICATIONS (Publicações multi-plataforma de conteúdo publicável)
// Polimórfico: ARTICLE | PIECE | VIDEO_SCRIPT → targetId.
// =============================================================================

model ContentPublication {
  id         String                @id @default(uuid())
  targetType PublicationTargetType // ARTICLE | PIECE | VIDEO_SCRIPT
  targetId   String                // articles.id | content_pieces.id | video_scripts.id
  platform   String                // "LINKEDIN" | "INSTAGRAM" | "outros" | ...
  url        String                // Link da publicação
  publishedAt DateTime             @default(now())
  createdAt   DateTime             @default(now())

  @@index([targetType, targetId])
  @@map("content_publications")
}
